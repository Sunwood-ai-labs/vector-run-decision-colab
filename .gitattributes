* text=auto
*.js text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
# Preserve exact bytes of hashed recording evidence, including the path inventory snapshot.
videos/*.json -text
# Keep formal evidence byte-identical across Windows and Linux checkouts.
results/**/*.json -text
*.md text eol=lf
*.yml text eol=lf
*.bat text eol=crlf
*.mp4 binary
*.png binary
*.webp binary
